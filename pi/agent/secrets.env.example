# DOKPLOY_URL           -> mcp.json env: DOKPLOY_URL
# DOKPLOY_API_KEY       -> mcp.json env: DOKPLOY_API_KEY
# DOKPLOY_CF_ACCESS_HEADERS -> mcp.json env: DOKPLOY_CUSTOM_HEADERS (JSON string)
#
# Copy to ~/.pi/agent/secrets.env, fill in real values, chmod 600.
# ~/.zshrc sources that file, so pi's MCP ${VAR} interpolation can resolve it.

export DOKPLOY_URL='https://dokploy.example.com'
export DOKPLOY_API_KEY='REPLACE_ME'
export DOKPLOY_CF_ACCESS_HEADERS='{"CF-Access-Client-Id":"REPLACE_ME.access","CF-Access-Client-Secret":"REPLACE_ME"}'
